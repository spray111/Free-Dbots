<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <!-- VARIABLES -->
  <variables>
    <variable id="nZ_%~crVCFpD!n=,@z}D">stake</variable>
    <variable id="CwR055G(]h0}2tgkj[A=">chooser</variable>
  </variables>

  <!-- MAIN TRADE DEFINITION -->
  <block type="trade_definition" id="main_trade" x="0" y="110">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ10V</field>
        <next>
          <block type="trade_definition_tradetype">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- INITIALIZATION LOGIC -->
    <statement name="INITIALIZATION">
      <block type="variable_sets">
        <field name="VAR" id="nZ_%~crVCFpD!n=,@z}D">stake</field>
        <value name="VALUE">
          <block type="math_number">
            <field name="NUM">5</field>
          </block>
        </value>
        <next>
          <block type="riskmanagment_settings">
            <statement name="STATEMENT">
              <block type="enable_martingale">
                <field name="ENABLE_MARTINGALE">true</field>
                <next>
                  <block type="use_split_martingale">
                    <field name="USE_SPLIT_MARTINGALE">false</field>
                    <next>
                      <block type="martingale">
                        <value name="MARTINGALE">
                          <shadow type="math_number">
                            <field name="NUM">2</field>
                          </shadow>
                        </value>
                        <next>
                          <block type="take_profit">
                            <value name="TAKE_PROFIT">
                              <shadow type="math_number">
                                <field name="NUM">111</field>
                              </shadow>
                            </value>
                            <next>
                              <block type="stop_loss">
                                <value name="STOP_LOSS">
                                  <shadow type="math_number">
                                    <field name="NUM">503</field>
                                  </shadow>
                                </value>
                                <next>
                                  <block type="max_split">
                                    <value name="MAX_SPLITS">
                                      <shadow type="math_number">
                                        <field name="NUM">3</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>

    <!-- TRADE OPTIONS -->
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"/>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number_positive">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <block type="variables_get">
            <field name="VAR" id="nZ_%~crVCFpD!n=,@z}D">stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!-- BEFORE PURCHASE -->
  <block type="before_purchase" x="0" y="1160">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="procedures_callnoreturn">
        <mutation name="choose_random_market"/>
        <next>
          <block type="apollo_purchase">
            <field name="PURCHASE_LIST">DIGITEVEN</field>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- DURING PURCHASE -->
  <block type="during_purchase" x="714" y="110">
    <statement name="DURING_PURCHASE_STACK">
      <block type="controls_if">
        <value name="IF0">
          <block type="check_sell"/>
        </value>
      </block>
    </statement>
  </block>

  <!-- AFTER PURCHASE -->
  <block type="after_purchase" x="714" y="392">
    <statement name="AFTERPURCHASE_STACK">
      <block type="trade_again"/>
    </statement>
  </block>

  <!-- RANDOM SYMBOL CHOOSER FUNCTION -->
  <block type="procedures_defnoreturn" x="0" y="1474">
    <field name="NAME">choose_random_market</field>
    <statement name="STACK">
      <block type="variable_sets">
        <field name="VAR" id="CwR055G(]h0}2tgkj[A=">chooser</field>
        <value name="VALUE">
          <block type="math_random_int">
            <value name="FROM">
              <shadow type="math_number">
                <field name="NUM">1</field>
              </shadow>
            </value>
            <value name="TO">
              <shadow type="math_number">
                <field name="NUM">9</field>
              </shadow>
            </value>
          </block>
        </value>
        <next>
          <block type="controls_if">
            <mutation elseif="8" else="1"/>
            <!-- Add symbol change logic here like in the uploaded XML -->
            <statement name="ELSE">
              <block type="active_symbol_changer">
                <field name="SYMBOL_ACTIVE_TYPE">disable</field>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
